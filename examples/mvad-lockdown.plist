<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.npmania.mvad-lockdown</string>
	<!-- The token and marker are where mvad lockdown off looks for them. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>[ -e /var/run/mvad/lockdown ] &amp;&amp; exit 0
/sbin/pfctl -q -a com.apple/mvad-lockdown -f /var/db/mvad/lockdown.pf || exit 1
/bin/mkdir -p /var/run/mvad
(umask 077; /sbin/pfctl -E 2&gt;&amp;1 | /usr/bin/sed -n 's/^Token : //p' &gt; /var/run/mvad/lockdown.token)
/usr/bin/touch /var/run/mvad/lockdown</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
